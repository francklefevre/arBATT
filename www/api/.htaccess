# arBATT - Table tennis club referee companion (PWA)
#
# Free software developed by Franck LEFEVRE for K1 ( https://k1info.com ),
# with the help of his team of kind and playful robots.
# Please use the enormous power of this software to do good things for things
# and people, always making sure it harms nothing and no one.
#
# ---------------------------------------------------------------------------
# 2026-10-06 (v0.1.13): routing of the PHP live relay (scoreboard / OBS mode)
# on Apache static hosting (OVH, WordPress hosts...).
#
#   api/live/<path>  ->  api/live.php?path=<path>
#
# The parent www/.htaccess turns mod_rewrite OFF for the app; this directory
# turns it back ON for itself only (per-directory rules are not inherited).
# ---------------------------------------------------------------------------

# 2026-10-11 (v0.1.16): MultiViews OFF. On OVH shared hosting content
# negotiation is enabled: a request for api/live/_info was mapped straight to
# live.php (with PATH_INFO=/_info) BEFORE the rewrite below ran, so live.php
# received no ?path= and answered "400 Bad Request" (seen on batt.club).
Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^live/(.*)$ live.php?path=$1 [QSA,L]
</IfModule>

# Never compress or cache the relay: compression buffers the SSE stream
# (events would arrive in bursts) and the data is real-time.
<IfModule mod_env.c>
  SetEnv no-gzip 1
</IfModule>
<IfModule mod_headers.c>
  Header set Cache-Control "no-cache, no-store"
</IfModule>

# Copy deployments (deploy/update.sh): tell live.php where config/ is, e.g.
#   SetEnv ARBATT_CONFIG_DIR /home/<user>/arbatt-src/config
# (see deploy/INSTALL.md). Not needed with the symlink / clone layouts.
